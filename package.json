{
  "name": "eeu-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check && npm run lint && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx,astro}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs,ts,tsx,astro}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.4.13",
    "@astrojs/react": "7.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript-eslint": "8.74.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
