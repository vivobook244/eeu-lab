---
import ReactIslandDemo from "../components/react/simulation/ReactIslandDemo";
import "../styles/global.css";

const title = "EEU LAB";
const description =
  "Explore. Experiment. Understand. Laboratorium fisika interaktif untuk belajar melalui eksperimen.";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <title>{title} — Laboratorium Fisika Interaktif</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <div class="relative isolate min-h-screen overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] bg-gradient-to-b from-blue-100/70 via-slate-50 to-slate-50"
      ></div>

      <header class="mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-6 sm:px-8 lg:px-12">
        <a href="/" class="flex items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600" aria-label="EEU LAB beranda">
          <span class="grid size-10 place-items-center rounded-xl bg-slate-950 text-sm font-black tracking-tight text-white">EEU</span>
          <span class="text-sm font-bold tracking-[0.16em] text-slate-800">EEU LAB</span>
        </a>
        <span class="rounded-full border border-blue-200 bg-white/80 px-3 py-1.5 text-xs font-semibold text-blue-800 shadow-sm">
          Interactive Physics Laboratory
        </span>
      </header>

      <main class="mx-auto flex w-full max-w-7xl flex-col px-5 pb-20 pt-14 sm:px-8 sm:pt-20 lg:px-12 lg:pt-24">
        <section class="mx-auto max-w-4xl text-center">
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-2 text-xs font-semibold tracking-[0.12em] text-slate-600 shadow-sm">
            <span class="size-2 rounded-full bg-emerald-500"></span>
            LABORATORIUM FISIKA INTERAKTIF
          </p>
          <h1 class="text-5xl font-black tracking-[-0.07em] text-slate-950 sm:text-7xl lg:text-8xl">
            {title}<span class="text-blue-600">.</span>
          </h1>
          <p class="mt-6 text-xl font-semibold tracking-tight text-slate-700 sm:text-2xl">
            Explore. Experiment. Understand.
          </p>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
            Pelajari fisika dengan mengeksplorasi konsep, mengubah parameter,
            melakukan eksperimen, dan memahami hasilnya.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <span class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10">
              Sedang dalam pengembangan
            </span>
            <span class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600">
              Fokus: Fisika
            </span>
          </div>
        </section>

        <section class="mx-auto mt-20 grid w-full max-w-5xl gap-4 sm:mt-24 sm:grid-cols-3" aria-label="Prinsip pembelajaran EEU LAB">
          <article class="rounded-2xl border border-slate-200/80 bg-white/80 p-6 shadow-sm shadow-slate-900/[0.03]">
            <span class="text-xs font-bold tracking-[0.16em] text-blue-700">01 / EXPLORE</span>
            <h2 class="mt-4 text-lg font-bold tracking-tight text-slate-900">Jelajahi konsep</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Pahami fenomena fisika melalui representasi yang mudah dieksplorasi.</p>
          </article>
          <article class="rounded-2xl border border-slate-200/80 bg-white/80 p-6 shadow-sm shadow-slate-900/[0.03]">
            <span class="text-xs font-bold tracking-[0.16em] text-blue-700">02 / EXPERIMENT</span>
            <h2 class="mt-4 text-lg font-bold tracking-tight text-slate-900">Lakukan eksperimen</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Ubah parameter dan amati bagaimana perubahan memengaruhi hasil.</p>
          </article>
          <article class="rounded-2xl border border-slate-200/80 bg-white/80 p-6 shadow-sm shadow-slate-900/[0.03]">
            <span class="text-xs font-bold tracking-[0.16em] text-blue-700">03 / UNDERSTAND</span>
            <h2 class="mt-4 text-lg font-bold tracking-tight text-slate-900">Pahami hasilnya</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Hubungkan pengamatan dengan persamaan, pengukuran, dan grafik.</p>
          </article>
        </section>

        <section class="mx-auto mt-16 w-full max-w-2xl sm:mt-20" aria-label="Status integrasi antarmuka">
          <ReactIslandDemo client:load />
        </section>
      </main>

      <footer class="mx-auto flex w-full max-w-7xl flex-col gap-2 border-t border-slate-200/80 px-5 py-7 text-center text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:text-left lg:px-12">
        <p class="font-semibold tracking-[0.12em] text-slate-600">EEU LAB</p>
        <p>Explore. Experiment. Understand.</p>
      </footer>
    </div>
  </body>
</html>
