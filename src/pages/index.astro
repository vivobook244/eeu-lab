---
const title = "EEU LAB";
const description =
  "Explore. Experiment. Understand. An interactive physics laboratory.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <title>{title} — Interactive Physics Laboratory</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Interactive Physics Laboratory</p>
      <h1>{title}</h1>
      <p class="tagline">Explore. Experiment. Understand.</p>
      <p class="description">
        A place to explore physics through interactive experiments.
      </p>
      <p class="status">The laboratory is being prepared.</p>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 320px;
    background: #f8fafc;
    color: #172033;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
  }

  main {
    display: grid;
    min-height: 100vh;
    align-content: center;
    justify-items: center;
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #52627a;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 12vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 1;
  }

  .tagline {
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 3vw, 1.35rem);
    font-weight: 600;
  }

  .description {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: #52627a;
    line-height: 1.7;
  }

  .status {
    margin: 2rem 0 0;
    border: 1px solid #d8e0eb;
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    color: #52627a;
    font-size: 0.85rem;
  }
</style>
